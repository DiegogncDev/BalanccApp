# Auto detect text files and perform LF normalization
* text=auto

# Kotlin / Java / Gradle source files -> LF
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.pro text eol=lf

# Shell scripts -> LF
*.sh text eol=lf

# Windows scripts -> CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.jar binary
*.class binary
